<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Bulico</RootNamespace>
    <AssemblyName>Bulico</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RevitInstallDir Condition="'$(RevitInstallDir)' == ''">C:\Program Files\Autodesk\Revit 2026</RevitInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitInstallDir)\RevitAPI.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitInstallDir)\RevitAPIUI.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Icons\grid_wall_32.png" />
    <EmbeddedResource Include="Resources\Icons\grid_wall_16.png" />
    <EmbeddedResource Include="Resources\Icons\wall_beam_32.png" />
    <EmbeddedResource Include="Resources\Icons\wall_beam_16.png" />
    <EmbeddedResource Include="Resources\Icons\wall_beam_floor_32.png" />
    <EmbeddedResource Include="Resources\Icons\wall_beam_floor_16.png" />
    <EmbeddedResource Include="Resources\Icons\room_floor_32.png" />
    <EmbeddedResource Include="Resources\Icons\room_floor_16.png" />
    <EmbeddedResource Include="Resources\Icons\elevation_grid_32.png" />
    <EmbeddedResource Include="Resources\Icons\elevation_grid_16.png" />
    <EmbeddedResource Include="Resources\Icons\mullion_32.png" />
    <EmbeddedResource Include="Resources\Icons\mullion_16.png" />
    <EmbeddedResource Include="Resources\Icons\door_window_mark_32.png" />
    <EmbeddedResource Include="Resources\Icons\door_window_mark_16.png" />
    <EmbeddedResource Include="Resources\Icons\same_type_32.png" />
    <EmbeddedResource Include="Resources\Icons\same_type_16.png" />
    <EmbeddedResource Include="Resources\Icons\category_filter_32.png" />
    <EmbeddedResource Include="Resources\Icons\category_filter_16.png" />
    <EmbeddedResource Include="Resources\Icons\fine_filter_32.png" />
    <EmbeddedResource Include="Resources\Icons\fine_filter_16.png" />
    <EmbeddedResource Include="Resources\Icons\about_32.png" />
    <EmbeddedResource Include="Resources\Icons\about_16.png" />
  </ItemGroup>

</Project>
