<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Bulico</RootNamespace>
    <AssemblyName>Bulico</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RevitInstallDir Condition="'$(RevitInstallDir)' == ''">C:\Program Files\Autodesk\Revit 2026</RevitInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitInstallDir)\RevitAPI.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitInstallDir)\RevitAPIUI.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\icon_gridwall_32.png" />
    <EmbeddedResource Include="Resources\icon_gridwall_16.png" />
    <EmbeddedResource Include="Resources\icon_beam_32.png" />
    <EmbeddedResource Include="Resources\icon_beam_16.png" />
    <EmbeddedResource Include="Resources\icon_floor_32.png" />
    <EmbeddedResource Include="Resources\icon_floor_16.png" />
    <EmbeddedResource Include="Resources\icon_filter_32.png" />
    <EmbeddedResource Include="Resources\icon_filter_16.png" />
    <EmbeddedResource Include="Resources\icon_doorwin_32.png" />
    <EmbeddedResource Include="Resources\icon_doorwin_16.png" />
    <EmbeddedResource Include="Resources\icon_mullion_32.png" />
    <EmbeddedResource Include="Resources\icon_mullion_16.png" />
    <EmbeddedResource Include="Resources\icon_category_32.png" />
    <EmbeddedResource Include="Resources\icon_category_16.png" />
    <EmbeddedResource Include="Resources\icon_fine_32.png" />
    <EmbeddedResource Include="Resources\icon_fine_16.png" />
    <EmbeddedResource Include="Resources\icon_about_32.png" />
    <EmbeddedResource Include="Resources\icon_about_16.png" />
    <EmbeddedResource Include="Resources\icon_roomfloor_32.png" />
    <EmbeddedResource Include="Resources\icon_roomfloor_16.png" />
    <EmbeddedResource Include="Resources\icon_elevgrid_32.png" />
    <EmbeddedResource Include="Resources\icon_elevgrid_16.png" />
  </ItemGroup>

</Project>
