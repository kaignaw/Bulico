<Window x:Class="Bulico.FloorSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="楼板设置"
        Width="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="楼板类型："
               VerticalAlignment="Center"/>
        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="TypeCombo"
                  Margin="4,4,0,4" DisplayMemberPath="Name"/>

        <Label Grid.Row="1" Grid.Column="0" Content="标高："
               VerticalAlignment="Center"/>
        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="LevelCombo"
                  Margin="4,4,0,4" DisplayMemberPath="Name"/>

        <Label Grid.Row="2" Grid.Column="0" Content="标高偏移（m）："
               VerticalAlignment="Center"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="OffsetBox"
                 Margin="4,4,0,4" Height="22"
                 VerticalContentAlignment="Center"/>

        <Label Grid.Row="3" Grid.Column="0" x:Name="ModeLabel" Content="生成方式："
               VerticalAlignment="Top" Margin="0,6,0,0"/>
        <StackPanel Grid.Row="3" Grid.Column="1" x:Name="ModePanel"
                    Orientation="Vertical" Margin="0,2,0,0">
            <RadioButton x:Name="CenterlineRadio" Content="墙梁中心线" GroupName="mode"
                         Margin="4,4,0,2"/>
            <RadioButton x:Name="InnerRadio" Content="墙梁内边线" GroupName="mode"
                         Margin="4,2,0,4"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Center"
                    Margin="0,10,0,0">
            <Button x:Name="OkButton" Content="确定" Width="80" Height="28"
                    Margin="0,0,8,0" IsDefault="True" Click="OkButton_Click"/>
            <Button x:Name="CancelButton" Content="取消" Width="80" Height="28"
                    IsCancel="True" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
